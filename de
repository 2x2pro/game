        </main>
        <script>
            document.addEventListener("DOMContentLoaded", function () {
                const searchInput = document.getElementById("search-input");
                const gameCards = document.querySelectorAll(".game-card");
        
                // Function to filter cards based on input
                searchInput.addEventListener("input", function () {
                    const searchText = searchInput.value.toLowerCase();
    
                    gameCards.forEach((card) => {
                        const gameTitle = card.querySelector("h3").textContent.toLowerCase();
        
                        // Check if title matches search text
                        if (gameTitle.includes(searchText)) {
                            card.style.display = "block"; // Show card if matches
                        } else {
                            card.style.display = "none"; // Hide card if no match
                        }
                    });
                });
            });
        </script>
